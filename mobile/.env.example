# ── tazdan mobile ───────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# API base URL — no trailing slash
# Normal dev: leave unset so Expo resolves localhost/LAN automatically.
# Dev override: EXPO_PUBLIC_API_BASE=http://192.168.x.x:5000/api
# Production:   EXPO_PUBLIC_API_BASE=https://api.promrkts.com
# EXPO_PUBLIC_API_BASE=

# Sentry DSN for crash reporting (optional in dev)
EXPO_PUBLIC_SENTRY_DSN=

# Stripe publishable key (pk_test_… / pk_live_…).
# REQUIRED for Apple Pay / Google Pay buttons to appear in Buy/Deposit.
# When unset, ExpressPayButton self-hides and only "Pay with card" shows.
# Note: also needs an EAS native build (Stripe is stubbed in Expo Go) and a
# real device — Apple Pay never renders in the simulator.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
