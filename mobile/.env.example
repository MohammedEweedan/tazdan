# ── promrkts mobile ──────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# API base URL — no trailing slash, include /api
# Dev (local):      http://localhost:5000/api
# Dev (LAN device): http://192.168.x.x:5000/api
# Production:       https://api.promrkts.com/api
EXPO_PUBLIC_API_BASE=http://localhost:5000/api

# Sentry DSN for crash reporting (optional in dev)
EXPO_PUBLIC_SENTRY_DSN=
