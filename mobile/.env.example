# ── tazdan mobile ───────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# Development: auto-detect Metro LAN IP, web hostname or simulator host.
# Backend default PORT is 5001. Change this if your server uses another port.
EXPO_PUBLIC_DEV_API_PORT=5001
# Explicit physical-device / tunnel override (same Wi-Fi as the backend):
# EXPO_PUBLIC_DEV_API_BASE=http://192.168.1.42:5001/api
# Release builds ignore the DEV settings and use this public HTTPS endpoint.
EXPO_PUBLIC_PROD_API_BASE=https://api.promrkts.com
# Legacy EXPO_PUBLIC_API_BASE is still supported; remove old local values
# before release, or set the dedicated PROD variable above.

# Sentry DSN for crash reporting (optional in dev)
EXPO_PUBLIC_SENTRY_DSN=

# Stripe publishable key (pk_test_… / pk_live_…).
# REQUIRED for Apple Pay / Google Pay buttons to appear in Buy/Deposit.
# When unset, ExpressPayButton self-hides and only "Pay with card" shows.
# Note: also needs an EAS native build (Stripe is stubbed in Expo Go) and a
# real device — Apple Pay never renders in the simulator.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
