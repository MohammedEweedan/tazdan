{
  "expo": {
    "name": "tazdan",
    "slug": "tazdan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tazdan",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/721a82c4-c3ec-472e-9636-891d30516a54",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/icon-color.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.tazdan.app",
      "associatedDomains": [
        "applinks:tazdan.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "tazdan uses Face ID to unlock your account and authorise sensitive actions."
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.tazdan.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "package": "com.tazdan.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tazdan.com",
              "pathPrefix": "/claim"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-react-native-bundle-ip-output",
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "tazdan uses Face ID to unlock your account and authorise sensitive actions."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.tazdan.app",
          "enableGooglePay": true
        }
      ],
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "tazdan uses your approximate location to show P2P traders near you. Your exact location is never shared with other users.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "tazdan uses the camera to scan payment QR codes and to photograph your ID documents for verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "tazdan uses your photos so you can upload ID documents for verification, send images in chat and set a profile picture.",
          "cameraPermission": "tazdan uses the camera to scan payment QR codes and to photograph your ID documents for verification.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "721a82c4-c3ec-472e-9636-891d30516a54"
      }
    },
    "owner": "aw1dan"
  }
}
