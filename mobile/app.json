{
  "expo": {
    "name": "Fortuni",
    "slug": "promrkts",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "Fortuni",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-color.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Fortuni.app",
      "associatedDomains": [
        "applinks:Fortuni.com",
        "applinks:Fortuni.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Fortuni uses Face ID to unlock your account and authorise sensitive actions."
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.Fortuni.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "package": "com.Fortuni.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "Fortuni.com", "pathPrefix": "/claim" },
            { "scheme": "https", "host": "Fortuni.app", "pathPrefix": "/claim" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fortuni uses Face ID to unlock your account and authorise sensitive actions."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.Fortuni.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "721a82c4-c3ec-472e-9636-891d30516a54"
      }
    },
    "owner": "aw1dan"
  }
}
