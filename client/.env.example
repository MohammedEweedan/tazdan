# Next.js client environment variables
# Copy to .env.local and fill in values

# API endpoint (include /api suffix)
NEXT_PUBLIC_API_URL=https://api.promrkts.com/api
NEXT_PUBLIC_WS_URL=https://api.promrkts.com

# Mailchimp waitlist integration
# Create at mailchimp.com → Account → Extras → API Keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Audience List ID: Mailchimp → Audience → Settings → Audience name and defaults
MAILCHIMP_LIST_ID=xxxxxxxxxx

# Sentry error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
