# Next.js client environment variables
# Copy to .env.local and fill in values

# API endpoint (include /api suffix). MUST match the domain nginx serves the
# backend on (see nginx/conf.d/tazdan.conf → server_name api.promrkts.com).
# A wrong host here makes the waitlist POST silently fail (no signup saved,
# no confirmation email sent) while the form still shows success.
NEXT_PUBLIC_API_URL=https://api.promrkts.com/api
NEXT_PUBLIC_WS_URL=https://api.promrkts.com

# Mailchimp waitlist integration
# Create at mailchimp.com → Account → Extras → API Keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Audience List ID: Mailchimp → Audience → Settings → Audience name and defaults
MAILCHIMP_LIST_ID=xxxxxxxxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=moeawidan99@gmail.com
SMTP_PASS=zqud gdvc hzgi ocna
MAIL_FROM="Support <moeawidan99@gmail.com>"

# Sentry error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
