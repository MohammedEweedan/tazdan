{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // No .d.ts emit: this is a server app, nothing imports it as a library, and
    // generating + serializing every export's type is the single most expensive
    // part of `tsc`. Dropping it roughly halves the Docker build with zero
    // behavior change (the runtime stage only ships dist/*.js). tsc still
    // type-checks everything, so this is not a safety reduction.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
