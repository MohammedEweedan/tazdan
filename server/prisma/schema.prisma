generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/// Distinguishes a personal user from a business customer.
/// BUSINESS users get a 1:1 BusinessProfile, higher transaction
/// limits, multi-seat dashboard, and access to /business APIs
/// (bulk payouts, invoicing, mass card issuance, treasury).
enum AccountType {
  PERSONAL
  BUSINESS
}

/// Lifecycle of a business KYB (Know-Your-Business) review.
enum KYBStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum DepositStatus {
  WAITING_CONFIRMATION
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  EXPIRED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  FEE
  COMMISSION
  REFERRAL_BONUS
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum Currency {
  // ── Crypto ────────────────────────────────
  USDT
  BTC
  ETH
  BNB
  SOL
  XRP
  ADA
  DOGE
  MATIC
  DOT
  AVAX
  // ── Major fiat ────────────────────────────
  USD
  EUR
  GBP
  // ── MENA fiat (used by P2P + on/off-ramp) ──
  AED // UAE Dirham
  SAR // Saudi Riyal
  EGP // Egyptian Pound
  LYD // Libyan Dinar — controlled FX, primary spread opportunity
}

// ── KYC tier (gates daily/monthly limits, P2P verified badge,
//             card issuance, and off-ramp eligibility) ────────────
enum KYCTier {
  TIER_0 // unverified — read-only, tiny send limit
  TIER_1 // basic ID — small daily limits
  TIER_2 // ID + address — standard limits, P2P verified badge
  TIER_3 // enhanced (PoF / video) — institutional limits
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum CardTier {
  STARTER
  MASTER
  PRO
}

enum CardStatus {
  PENDING
  ACTIVE
  FROZEN
  CANCELLED
}

enum CardTxType {
  PURCHASE
  REFUND
  FEE
  CASHBACK
  TOPUP
  WITHDRAWAL
}

model User {
  id                           String                       @id @default(uuid())
  email                        String                       @unique
  phone                        String?                      @unique
  passwordHash                 String
  firstName                    String
  lastName                     String
  role                         UserRole                     @default(USER)
  accountType                  AccountType                  @default(PERSONAL)
  status                       UserStatus                   @default(PENDING)
  kycStatus                    KYCStatus                    @default(NOT_SUBMITTED)
  kycTier                      KYCTier                      @default(TIER_0) // gates daily limits, card issuance, off-ramp
  country                      String? // ISO 3166-1 alpha-2 (e.g. "AE", "SA", "LY") — drives P2P & compliance
  phoneCountryCode             String? // dial code WITHOUT '+' (e.g. "218", "971", "966")
  dateOfBirth                  DateTime? // 18+ enforced at registration; required for KYC and AML
  twoFactorSecret              String?
  twoFactorEnabled             Boolean                      @default(false)
  emailVerified                Boolean                      @default(false)
  emailVerificationToken       String?                      @unique
  emailVerificationExpires     DateTime?
  emailVerificationCode        String?
  emailVerificationCodeExpires DateTime?
  passwordResetToken           String?                      @unique
  passwordResetExpires         DateTime?
  phoneVerified                Boolean                      @default(false)
  phoneOtpCode                 String?
  phoneOtpExpires              DateTime?
  referralCode                 String                       @unique
  referredBy                   String?
  lastLoginAt                  DateTime?
  lastLoginIp                  String?
  // Brute-force protection: counts consecutive failed login attempts.
  // Reset to 0 on successful login. When >= threshold, the account is
  // locked until `lockoutUntil`.
  failedLoginAttempts          Int                          @default(0)
  lockoutUntil                 DateTime?
  expoPushToken                String? // Expo push notification token (nullable — registered after login)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  wallets                      Wallet[]
  deposits                     Deposit[]
  withdrawals                  Withdrawal[]
  orders                       Order[]
  transactions                 Transaction[]
  kycDocuments                 KYCDocument[]
  notifications                Notification[]
  sessions                     Session[]
  bankAccounts                 BankAccount[]
  linkedWallets                LinkedWallet[]
  referrals                    User[]                       @relation("Referrals")
  referrer                     User?                        @relation("Referrals", fields: [referredBy], references: [id])
  whatsappMessages             WhatsAppMessage[]
  sentTransfers                Transfer[]                   @relation("TransferSender")
  receivedTransfers            Transfer[]                   @relation("TransferReceiver")
  // Public profile
  username                     String?                      @unique
  bio                          String?
  avatarUrl                    String?
  baseCurrency                 Currency                     @default(USD)
  profilePublic                Boolean                      @default(false)
  acceptedCurrencies           String[]                     @default(["USDT", "USD", "BTC", "ETH"])
  // P2P relations
  p2pListings                  P2PListing[]
  p2pTradesAsBuyer             P2PTrade[]                   @relation("P2PBuyer")
  p2pTradesAsSeller            P2PTrade[]                   @relation("P2PSeller")
  p2pDisputes                  P2PDispute[]
  // Messages
  sentMessages                 Message[]                    @relation("MessageSender")
  receivedMessages             Message[]                    @relation("MessageReceiver")
  blocksMade                   UserBlock[]                  @relation("BlocksMade")
  blocksAgainst                UserBlock[]                  @relation("BlocksAgainst")
  reportsFiled                 MessageReport[]              @relation("ReportsFiled")
  reportsAgainst               MessageReport[]              @relation("ReportsAgainst")
  // Group chats
  groupsCreated                GroupChat[]                  @relation("GroupCreator")
  groupMemberships             GroupMember[]
  groupMessagesSent            GroupMessage[]               @relation("GroupMessageSender")
  poolsCreated                 LiquidityPool[]              @relation("PoolCreator")
  poolMemberships              LiquidityPoolMember[]
  poolContributions            LiquidityPoolContribution[]
  escalationsRaised            SupportEscalation[]          @relation("EscalationsRaised")
  escalationsAssigned          SupportEscalation[]          @relation("EscalationsAssigned")
  // Memecoins & Smart Contracts
  // AML
  amlFlags                     AMLFlag[]
  // Referral rewards, API keys, login history
  apiKeys                      APIKey[]
  loginHistory                 LoginHistory[]
  // Virtual Visa cards
  cards                        Card[]
  cardTransactions             CardTransaction[]
  // Refresh tokens (rotation-friendly — multiple active sessions)
  refreshTokens                RefreshToken[]
  // On-ramp / off-ramp transactions
  onRampTxns                   OnRampTransaction[]
  offRampTxns                  OffRampTransaction[]
  // Crypto custody (BIP-39 derived multi-chain wallet)
  cryptoWallet                 UserWallet?
  cryptoOrders                 CryptoOrder[]
  onChainTxs                   OnChainTransaction[]
  withdrawalAddressWhitelist   WithdrawalAddressWhitelist[]
  // 1:1 — only present when accountType = BUSINESS
  businessProfile              BusinessProfile?

  @@index([email])
  @@index([referralCode])
  @@index([username])
  @@index([country])
  @@index([kycTier])
  @@index([accountType])
}

/// One-to-one extension of User for BUSINESS accounts.
/// Holds the company legal record, KYB state, and the small set of
/// B2B fields the dashboard needs (billing email, support contact,
/// industry segmentation for fee tiers, employee headcount for plan
/// selection). PersonalProfile data lives directly on User; only
/// the business-specific bits need this side-table.
model BusinessProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  companyName     String
  legalName       String?
  registrationNo  String? // company registration / commercial licence
  taxId           String? // VAT, EIN, or local equivalent
  /// ISO 3166-1 alpha-2 of company registration country.
  country         String
  /// Free-text industry tag (e.g. "fintech", "ecommerce", "remittances"). Drives fee tier.
  industry        String?
  /// Bucketed headcount: "1-10", "11-50", "51-200", "201-1000", "1000+"
  employeeCount   String?
  website         String?
  /// Operations contact — defaults to User.email but split so finance
  /// & ops can have different inboxes.
  billingEmail    String?
  supportEmail    String?
  /// Free-text use case so sales can route demo requests.
  useCase         String?
  /// Estimated monthly USD volume — informs onboarding tier.
  monthlyVolumeUsd Decimal? @db.Decimal(20, 2)
  kybStatus       KYBStatus @default(NOT_SUBMITTED)
  kybNotes        String?
  kybReviewedAt   DateTime?
  kybReviewedBy   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([kybStatus])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  currency  Currency
  balance   Decimal  @default(0) @db.Decimal(20, 8)
  frozen    Decimal  @default(0) @db.Decimal(20, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@index([userId])
}

model Deposit {
  id            String        @id @default(uuid())
  userId        String
  currency      Currency
  amount        Decimal       @db.Decimal(20, 8)
  paymentMethod PaymentMethod
  status        DepositStatus @default(PENDING)
  reference     String        @unique
  proofImageUrl String?
  bankName      String?
  accountNumber String?
  senderName    String?
  notes         String?
  adminNotes    String?
  confirmedAt   DateTime?
  confirmedBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reference])
}

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  currency      Currency
  amount        Decimal          @db.Decimal(20, 8)
  fee           Decimal          @default(0) @db.Decimal(20, 8)
  netAmount     Decimal          @db.Decimal(20, 8)
  paymentMethod PaymentMethod?
  walletAddress String?
  network       String?
  bankName      String?
  accountNumber String?
  accountName   String?
  status        WithdrawalStatus @default(PENDING)
  reference     String           @unique
  adminNotes    String?
  processedAt   DateTime?
  processedBy   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onChainTxs    OnChainTx[]

  @@index([userId])
  @@index([status])
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  side          OrderSide
  type          OrderType   @default(MARKET)
  baseCurrency  Currency    @default(USDT)
  quoteCurrency Currency
  amount        Decimal     @db.Decimal(20, 8)
  price         Decimal     @db.Decimal(20, 8)
  filled        Decimal     @default(0) @db.Decimal(20, 8)
  total         Decimal     @db.Decimal(20, 8)
  fee           Decimal     @default(0) @db.Decimal(20, 8)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  type            TransactionType
  currency        Currency
  amount          Decimal         @db.Decimal(20, 8)
  fee             Decimal         @default(0) @db.Decimal(20, 8)
  balanceBefore   Decimal         @db.Decimal(20, 8)
  balanceAfter    Decimal         @db.Decimal(20, 8)
  reference       String?
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderMessage   Message?        @relation("MessageSenderTx")
  receiverMessage Message?        @relation("MessageReceiverTx")

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model KYCDocument {
  id              String    @id @default(uuid())
  userId          String
  documentType    String
  documentUrl     String
  status          KYCStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  branch        String?
  country       String? // ISO 3166-1 alpha-2 (e.g. "GB", "US", "AE")
  currency      String? // ISO 4217 currency code (e.g. "GBP", "USD", "EUR")
  sortCode      String? // UK sort code (6 digits)
  routingNumber String? // US/CA/AU routing number (9 digits)
  iban          String? // International Bank Account Number
  swift         String? // SWIFT/BIC code
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([country])
}

model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  Currency @default(USDT)
  quoteCurrency Currency
  buyPrice      Decimal  @db.Decimal(20, 8)
  sellPrice     Decimal  @db.Decimal(20, 8)
  isActive      Boolean  @default(true)
  setBy         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@index([baseCurrency, quoteCurrency])
}

model PlatformSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Unified fee ledger — every commission or transaction fee the
/// platform takes is recorded here AND credited to the platform
/// wallet (the user with username='platform'). Fees from deposits
/// and internal transfers are intentionally excluded.
model PlatformFee {
  id          String   @id @default(uuid())
  /// Where the fee originated: order, withdrawal, p2p, swap, crypto_order, p2p_trade
  source      String
  sourceId    String?
  /// The user who paid the fee
  payerId     String?
  amount      Decimal  @db.Decimal(20, 8)
  currency    Currency
  /// USD equivalent at time of capture, for dashboard aggregation
  amountUsd   Decimal  @default(0) @db.Decimal(20, 8)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([payerId])
  @@index([currency])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  subtitle    String?
  message     String
  description String?
  mediaUrl    String?
  mediaType   String? // image | gif | video | none
  locales     Json? // { "ar": { "title": "...", "subtitle": "...", "description": "..." } }
  type        String   @default("info")
  isRead      Boolean  @default(false)
  metadata    Json?
  createdBy   String? // admin userId who sent the broadcast (null for system notifications)
  broadcastId String? // shared UUID across all rows of a single broadcast batch
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([broadcastId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model LinkedWallet {
  id        String   @id @default(uuid())
  userId    String
  address   String
  network   String
  label     String   @default("My Wallet")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OnChainTxStatus {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

model OnChainTx {
  id           String          @id @default(uuid())
  withdrawalId String
  toAddress    String
  network      String          @default("TRC20")
  amount       Decimal         @db.Decimal(20, 8)
  currency     Currency        @default(USDT)
  status       OnChainTxStatus @default(QUEUED)
  txHash       String?
  sentAt       DateTime?
  confirmedAt  DateTime?
  error        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  withdrawal   Withdrawal      @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([status])
  @@index([txHash])
}

model Transfer {
  id               String                     @id @default(uuid())
  senderId         String
  receiverId       String
  currency         Currency                   @default(USDT)
  amount           Decimal                    @db.Decimal(20, 8)
  fee              Decimal                    @default(0) @db.Decimal(20, 8)
  reference        String                     @unique
  note             String?
  createdAt        DateTime                   @default(now())
  sender           User                       @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User                       @relation("TransferReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  message          Message?                   @relation("MessageTransfer")
  poolContribution LiquidityPoolContribution? @relation("PoolContribTransfer")

  @@index([senderId])
  @@index([receiverId])
  @@index([reference])
  @@index([createdAt])
}

// ── P2P Marketplace ─────────────────────────────────────────────────
enum P2PListingStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum P2PTradeStatus {
  AWAITING_ESCROW // Seller hasn't funded escrow yet
  ESCROW_FUNDED // Seller's crypto locked in escrow
  PAYMENT_SENT // Buyer claims they've sent fiat
  PAYMENT_CONFIRMED // Seller confirms receipt of fiat
  COMPLETED // Trade finished, crypto released
  DISPUTED // One party raised a dispute
  CANCELLED // Trade cancelled
  EXPIRED // Trade expired
}

enum P2PDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

model P2PListing {
  id             String           @id @default(uuid())
  userId         String
  currency       Currency         @default(USDT)
  baseAsset      String? // free-text ticker for any altcoin (e.g. PEPE, SHIB); overrides currency when set
  fiatCurrency   Currency         @default(USD)
  fiatAsset      String? // free-text fiat ticker when fiatCurrency overflows the enum
  side           OrderSide // BUY or SELL
  price          Decimal          @db.Decimal(20, 8) // price per unit in fiat
  amount         Decimal          @db.Decimal(20, 8) // total crypto amount
  minLimit       Decimal          @db.Decimal(20, 8) // min trade amount
  maxLimit       Decimal          @db.Decimal(20, 8) // max trade amount
  filled         Decimal          @default(0) @db.Decimal(20, 8)
  paymentMethods String[]         @default(["BANK_TRANSFER"])
  country        String? // ISO 3166-1 alpha-2 — restrict to traders in this jurisdiction
  city           String? // city shown only when cash payment is offered
  timeframeMins  Int              @default(30) // buyer payment window in minutes
  terms          String? // seller's terms
  autoReply      String? // auto message to buyer
  anonymous      Boolean          @default(false) // mask user identity on public marketplace
  status         P2PListingStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades         P2PTrade[]

  @@index([userId])
  @@index([currency, fiatCurrency, side, status])
  @@index([baseAsset, side, status])
  @@index([country])
  @@index([status])
  @@index([createdAt])
}

model P2PTrade {
  id              String         @id @default(uuid())
  listingId       String
  buyerId         String
  sellerId        String
  currency        Currency
  baseAsset       String? // free-text ticker when currency overflows the enum
  fiatCurrency    Currency
  fiatAsset       String? // free-text fiat ticker when fiatCurrency overflows the enum
  cryptoAmount    Decimal        @db.Decimal(20, 8)
  fiatAmount      Decimal        @db.Decimal(20, 8)
  price           Decimal        @db.Decimal(20, 8)
  escrowAmount    Decimal        @db.Decimal(20, 8) // amount locked in escrow
  status          P2PTradeStatus @default(AWAITING_ESCROW)
  reference       String         @unique
  buyerNote       String?
  sellerNote      String?
  paymentMethod   String?
  paymentProofUrl String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  expiresAt       DateTime? // auto-cancel if not funded
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  listing         P2PListing     @relation(fields: [listingId], references: [id])
  buyer           User           @relation("P2PBuyer", fields: [buyerId], references: [id])
  seller          User           @relation("P2PSeller", fields: [sellerId], references: [id])
  disputes        P2PDispute[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
}

model P2PDispute {
  id             String           @id @default(uuid())
  tradeId        String
  raisedById     String
  reason         String
  evidence       String[]         @default([])
  status         P2PDisputeStatus @default(OPEN)
  resolution     String? // admin resolution notes
  penaltyPercent Decimal?         @db.Decimal(5, 2) // 5.00% to 100.00%
  penaltyUserId  String? // who gets penalised
  penaltyAmount  Decimal?         @db.Decimal(20, 8)
  resolvedBy     String? // admin id
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  trade          P2PTrade         @relation(fields: [tradeId], references: [id])
  raisedBy       User             @relation(fields: [raisedById], references: [id])

  @@index([tradeId])
  @@index([raisedById])
  @@index([status])
}

// ── In-App Messaging ─────────────────────────────────────────────────
model Message {
  id           String          @id @default(uuid())
  senderId     String
  receiverId   String
  content      String
  /// TEXT, PAYMENT, SYSTEM, P2P_NOTE, ESCALATION
  type         String          @default("TEXT")
  /// Structured payload: for PAYMENT { amount, currency, txRef, status }
  metadata     Json?
  isRead       Boolean         @default(false)
  readAt       DateTime?
  editedAt     DateTime?
  /// Soft-delete: bubble shows "Message deleted" but preserves audit trail.
  deletedAt    DateTime?
  /// Optional link back to a P2P trade so escalations + escrow chats join up.
  tradeId      String?
  createdAt    DateTime        @default(now())
  sender       User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User            @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  reports      MessageReport[]
  // Financial linkage: PAYMENT messages can reference the underlying Transfer
  // and the Transaction records that moved the funds.
  transfer     Transfer?       @relation("MessageTransfer", fields: [transferId], references: [id])
  transferId   String?         @unique
  senderTx     Transaction?    @relation("MessageSenderTx", fields: [senderTxId], references: [id])
  senderTxId   String?         @unique
  receiverTx   Transaction?    @relation("MessageReceiverTx", fields: [receiverTxId], references: [id])
  receiverTxId String?         @unique

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
  @@index([tradeId])
  @@index([transferId])
  @@index([createdAt])
}

/// ───────────────────────────────────────────────────────────────────
/// Group chats. Intentionally separate from the 1-to-1 Message model
/// above so DMs stay untouched. A GroupChat has any number of members
/// (>= 2), each with a role and a granular permissions JSON. Messages
/// in a group live in GroupMessage. A group can optionally have one
/// LiquidityPool attached.
/// ───────────────────────────────────────────────────────────────────
enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupChat {
  id          String         @id @default(uuid())
  name        String
  avatarUrl   String?
  description String?
  createdById String
  /// Once dissolved, no new messages or pool actions are accepted but the
  /// history stays queryable for audit + dispute reasons.
  dissolvedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]
  pool        LiquidityPool?

  @@index([createdById])
  @@index([createdAt])
}

model GroupMember {
  id          String          @id @default(uuid())
  groupId     String
  userId      String
  role        GroupMemberRole @default(MEMBER)
  /// Granular per-member permission overrides. Keys understood by the
  /// server: canInvite, canRemove, canRename, canManagePool, canPinMessage.
  /// Missing keys fall back to role defaults.
  permissions Json?
  joinedAt    DateTime        @default(now())
  /// Soft leave — keeps the row so old messages still resolve to a member.
  leftAt      DateTime?
  /// Per-member cursor so we can compute unread counts without scanning all messages.
  lastReadAt  DateTime?
  group       GroupChat       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupMessage {
  id            String         @id @default(uuid())
  groupId       String
  senderId      String
  /// TEXT, IMAGE, SYSTEM, POOL_CREATED, POOL_DEPOSIT, POOL_WITHDRAW, POOL_CLOSED
  type          String         @default("TEXT")
  /// Free-text content. Empty for IMAGE-only messages (use attachmentUrl).
  content       String         @default("")
  /// URL returned by the upload middleware (e.g. /uploads/chat/abcd.jpg).
  attachmentUrl String?
  /// Structured payload — e.g. for POOL_DEPOSIT { amount, currency, contributionId }.
  metadata      Json?
  /// Optional in-thread reply.
  replyToId     String?
  editedAt      DateTime?
  /// Soft-delete: bubble shows "Message deleted" but preserves audit trail.
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  group         GroupChat      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender        User           @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo       GroupMessage?  @relation("GroupMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       GroupMessage[] @relation("GroupMessageReply")

  @@index([groupId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

/// ───────────────────────────────────────────────────────────────────
/// Liquidity pools — one optional pool per group. Two kinds:
///   - SHARED_WALLET: members contribute any currency, anyone can
///                    request a withdraw of their share at any time.
///                    Pool tracks each member's totalContributedUsd and
///                    derives share % from that.
///   - GOAL_BASED:    a "savings jar" with a target amount + deadline.
///                    Contributions accumulate; withdrawals are blocked
///                    until goal is met OR an admin closes the pool.
/// ───────────────────────────────────────────────────────────────────
enum LiquidityPoolKind {
  SHARED_WALLET
  GOAL_BASED
}

enum LiquidityPoolStatus {
  OPEN
  LOCKED // goal-based, waiting for goal or deadline
  COMPLETED // goal reached / fully distributed
  DISSOLVED // admin closed early, funds returned pro-rata
}

model LiquidityPool {
  id              String                      @id @default(uuid())
  groupId         String                      @unique
  name            String
  kind            LiquidityPoolKind           @default(SHARED_WALLET)
  status          LiquidityPoolStatus         @default(OPEN)
  /// USD-denominated target. Required when kind = GOAL_BASED, nullable for SHARED_WALLET.
  targetAmountUsd Decimal?                    @db.Decimal(20, 4)
  /// Deadline for GOAL_BASED pools. Nullable for SHARED_WALLET.
  deadline        DateTime?
  /// Total currently held (sum of contributions − withdrawals), in USD.
  totalBalanceUsd Decimal                     @default(0) @db.Decimal(20, 4)
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  group           GroupChat                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User                        @relation("PoolCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members         LiquidityPoolMember[]
  contributions   LiquidityPoolContribution[]

  @@index([createdById])
  @@index([status])
}

model LiquidityPoolMember {
  id                  String        @id @default(uuid())
  poolId              String
  userId              String
  /// Lifetime contribution (USD-equivalent at deposit time) — drives share %.
  totalContributedUsd Decimal       @default(0) @db.Decimal(20, 4)
  /// Lifetime withdrawn (USD-equivalent at withdraw time).
  totalWithdrawnUsd   Decimal       @default(0) @db.Decimal(20, 4)
  joinedAt            DateTime      @default(now())
  pool                LiquidityPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
}

enum LiquidityPoolContribDirection {
  DEPOSIT
  WITHDRAW
}

model LiquidityPoolContribution {
  id         String                        @id @default(uuid())
  poolId     String
  userId     String
  direction  LiquidityPoolContribDirection
  amount     Decimal                       @db.Decimal(30, 8)
  currency   String
  /// USD-equivalent at the moment of the contribution — used for share math.
  amountUsd  Decimal                       @db.Decimal(20, 4)
  /// Optional reference to the underlying Transfer record (so the pool
  /// movement shows up in the user's activity feed too).
  transferId String?                       @unique
  createdAt  DateTime                      @default(now())
  pool       LiquidityPool                 @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user       User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfer   Transfer?                     @relation("PoolContribTransfer", fields: [transferId], references: [id])

  @@index([poolId, createdAt])
  @@index([userId])
}

/// Per-direction block. A block by A on B prevents B from messaging A.
/// Two-way blocks just become two rows; keeps the lookup trivially indexed.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksAgainst", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

/// Reports against a specific message OR a user (messageId optional).
/// Admin reviews these in the dashboard; status drives moderation queue.
model MessageReport {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  messageId      String?
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User         @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

enum EscalationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

/// Escalates a P2P escrow conversation into a support thread. The
/// support agent gets read access to the original participants' chat
/// and can post into a shared thread keyed by escalationId.
model SupportEscalation {
  id              String           @id @default(uuid())
  raisedById      String
  /// Opposite participant on the original P2P chat (so support can see both sides).
  counterpartyId  String
  /// Optional — populated when escalation originates from a P2P trade.
  tradeId         String?
  reason          String
  details         String?
  status          EscalationStatus @default(OPEN)
  assignedAgentId String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  raisedBy        User             @relation("EscalationsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  assignedAgent   User?            @relation("EscalationsAssigned", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@index([raisedById])
  @@index([counterpartyId])
  @@index([tradeId])
  @@index([status])
  @@index([createdAt])
}

// ── Memecoin Minting ─────────────────────────────────────────────────
// ── Smart Contract Templates ─────────────────────────────────────────
// ── AML / Compliance ─────────────────────────────────────────────────
enum AMLFlagStatus {
  OPEN
  REVIEWING
  CLEARED
  ESCALATED
  FROZEN
}

enum AMLFlagType {
  HIGH_VOLUME
  RAPID_TRANSACTIONS
  SUSPICIOUS_PATTERN
  SANCTIONED_ADDRESS
  STRUCTURING
  MANUAL
}

model AMLFlag {
  id             String        @id @default(uuid())
  userId         String
  type           AMLFlagType
  severity       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description    String
  transactionRef String? // related transaction
  amount         Decimal?      @db.Decimal(20, 8)
  currency       Currency?
  status         AMLFlagStatus @default(OPEN)
  autoAction     String? // HOLD, FREEZE, NONE
  reviewedBy     String?
  reviewedAt     DateTime?
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
}

// ── Referral Rewards ─────────────────────────────────────────────────
model ReferralReward {
  id          String    @id @default(uuid())
  referrerId  String
  referredId  String
  tier        Int       @default(1) // 1=direct, 2=indirect
  amount      Decimal   @db.Decimal(20, 8)
  currency    Currency  @default(USDT)
  triggerType String // REGISTRATION, FIRST_TRADE, DEPOSIT, MONTHLY_VOLUME
  triggerRef  String? // reference to the triggering event
  paid        Boolean   @default(false)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId])
  @@index([referredId])
  @@index([paid])
  @@index([createdAt])
}

// ── API Keys ─────────────────────────────────────────────────────────
model APIKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  prefix      String // first 8 chars for display "awk_xxxx..."
  permissions String[]  @default(["read"])
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ── Login History ────────────────────────────────────────────────────
model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  device    String? // parsed device name
  location  String? // geo-ip location
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model WhatsAppMessage {
  id          String   @id @default(uuid())
  userId      String?
  phoneNumber String
  message     String
  direction   String // "IN" or "OUT"
  status      String   @default("SENT") // "SENT", "DELIVERED", "READ", "FAILED"
  botResponse Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([userId])
  @@index([direction])
  @@index([createdAt])
}

// ── Virtual Visa cards ───────────────────────────────────────────────
model Card {
  id              String            @id @default(uuid())
  userId          String
  tier            CardTier          @default(STARTER)
  status          CardStatus        @default(PENDING)
  // Card details (last4 shown to user, full pan encrypted externally)
  nickname        String? // user-given label
  last4           String // "1144"
  expiryMonth     Int // 1-12
  expiryYear      Int // 4-digit
  cardHolder      String // "RAYAN ZAHI"
  currency        Currency          @default(USDT)
  // Balances / spend
  spentTotal      Decimal           @default(0) @db.Decimal(20, 8)
  spentMonth      Decimal           @default(0) @db.Decimal(20, 8)
  dailyLimit      Decimal           @default(5000) @db.Decimal(20, 8)
  monthlyLimit    Decimal           @default(50000) @db.Decimal(20, 8)
  cashbackRate    Decimal           @default(0.01) @db.Decimal(6, 4) // 1% default
  cashbackBalance Decimal           @default(0) @db.Decimal(20, 8)
  // Controls
  frozen          Boolean           @default(false)
  contactlessOn   Boolean           @default(true)
  onlineOn        Boolean           @default(true)
  atmOn           Boolean           @default(true)
  issuedAt        DateTime?
  activatedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    CardTransaction[]

  @@index([userId])
  @@index([status])
  @@index([last4])
}

model CardTransaction {
  id             String     @id @default(uuid())
  cardId         String
  userId         String
  type           CardTxType
  merchant       String?
  category       String? // e.g. "groceries", "travel", "subscription"
  country        String? // ISO country code
  amount         Decimal    @db.Decimal(20, 8)
  currency       Currency   @default(USDT)
  fxRate         Decimal?   @db.Decimal(20, 8) // rate used if merchant currency != card currency
  cashback       Decimal    @default(0) @db.Decimal(20, 8)
  declined       Boolean    @default(false)
  declinedReason String?
  reference      String     @unique
  metadata       Json?
  createdAt      DateTime   @default(now())
  card           Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// Refresh tokens — JWT rotation. Hashed token stored, not raw value.
// ─────────────────────────────────────────────────────────────────────
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique // sha256 of raw refresh token
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime? // null = active
  replacedById String? // rotated chain (which token replaced this one)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─────────────────────────────────────────────────────────────────────
// Market listings — drives the /markets endpoint.
// `isNew = true` if listed within last 7 days (recomputed by cron).
// ─────────────────────────────────────────────────────────────────────
model MarketListing {
  id          String   @id @default(uuid())
  symbol      String   @unique // "BTCUSDT", "ETHUSDT" — Binance pair format
  baseAsset   Currency // BTC, ETH, …
  quoteAsset  Currency @default(USDT)
  displayName String? // "Bitcoin"
  iconUrl     String?
  isActive    Boolean  @default(true)
  isNew       Boolean  @default(false) // listed within last 7 days
  listedAt    DateTime @default(now())
  rank        Int      @default(0) // display ordering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([isActive])
  @@index([isNew])
  @@index([rank])
}

// ─────────────────────────────────────────────────────────────────────
// On-ramp / Off-ramp transactions
// Each row = one user-initiated fiat<>crypto transaction routed through
// an external provider (MoonPay, Transak, Stripe, Sardine, Revolut...).
// ─────────────────────────────────────────────────────────────────────
enum RampStatus {
  QUOTED // quote returned, not yet confirmed
  PENDING // user confirmed; payment authorising
  PROCESSING // funds in flight at provider
  COMPLETED // settled to/from user wallet
  FAILED
  CANCELLED
  REFUNDED
}

enum RampProvider {
  MOCK // local stub for dev
  MOONPAY
  TRANSAK
  SARDINE
  STRIPE
  REVOLUT
}

enum RampPaymentMethod {
  CARD // Visa / Mastercard via Stripe etc.
  APPLE_PAY
  GOOGLE_PAY
  REVOLUT
  BANK_TRANSFER
  SEPA
  ACH
  CRYPTO // for off-ramp send
}

model OnRampTransaction {
  id             String            @id @default(uuid())
  userId         String
  provider       RampProvider      @default(MOCK)
  providerRef    String? // external transaction id (idempotent)
  status         RampStatus        @default(QUOTED)
  // Quote inputs
  fiatCurrency   Currency
  fiatAmount     Decimal           @db.Decimal(20, 8) // user pays this
  cryptoCurrency Currency
  cryptoAmount   Decimal           @db.Decimal(20, 8) // user receives this
  exchangeRate   Decimal           @db.Decimal(20, 8)
  feeAmount      Decimal           @default(0) @db.Decimal(20, 8)
  feeCurrency    Currency
  // Payment routing
  paymentMethod  RampPaymentMethod
  network        String? // for crypto delivery (TRC20, ERC20, BEP20...)
  // Lifecycle
  reference      String            @unique // internal idempotency key
  webhookPayload Json? // last raw provider webhook
  failureReason  String?
  quotedAt       DateTime?
  completedAt    DateTime?
  expiresAt      DateTime? // quote expiry
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([providerRef])
  @@index([reference])
  @@index([createdAt])
}

model OffRampTransaction {
  id                  String            @id @default(uuid())
  userId              String
  provider            RampProvider      @default(MOCK)
  providerRef         String?
  status              RampStatus        @default(QUOTED)
  // Quote
  cryptoCurrency      Currency // user sends this
  cryptoAmount        Decimal           @db.Decimal(20, 8)
  fiatCurrency        Currency // user receives this
  fiatAmount          Decimal           @db.Decimal(20, 8)
  exchangeRate        Decimal           @db.Decimal(20, 8)
  feeAmount           Decimal           @default(0) @db.Decimal(20, 8)
  feeCurrency         Currency
  // Payout routing
  payoutMethod        RampPaymentMethod
  payoutBankAccountId String? // optional FK to BankAccount (manual link, not enforced relation)
  payoutAddress       String? // for CRYPTO payouts (external wallet)
  // Lifecycle
  reference           String            @unique
  webhookPayload      Json?
  failureReason       String?
  quotedAt            DateTime?
  completedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([providerRef])
  @@index([reference])
  @@index([createdAt])
}

// ── Crypto Custody ───────────────────────────────────────────────────
// One master BIP-39 seed (stored encrypted in MasterSeedStore) derives
// all user wallets via BIP-44. Private keys are never persisted — they
// are re-derived on-demand from the master seed using walletIndex.
model UserWallet {
  id          String @id @default(cuid())
  userId      String @unique
  walletIndex Int    @unique @default(autoincrement())

  ethAddress  String @unique
  btcAddress  String @unique
  solAddress  String @unique
  tronAddress String @unique

  ethBalance   Decimal @default(0) @db.Decimal(36, 18)
  btcBalance   Decimal @default(0) @db.Decimal(20, 8)
  solBalance   Decimal @default(0) @db.Decimal(20, 9)
  usdtErc20Bal Decimal @default(0) @db.Decimal(20, 6)
  usdtTrc20Bal Decimal @default(0) @db.Decimal(20, 6)

  // Generic ledger for any other asset (BNB, XRP, DOGE, MATIC, etc.)
  // Stored as { "BNB": "1.234", "XRP": "500.000000", ... }
  altBalances Json @default("{}")

  selfCustodyExported Boolean   @default(false)
  exportedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Encrypted master seed blob. MVP: AES-256-GCM with MASTER_SEED_ENC_KEY.
// TODO: migrate to AWS KMS (MASTER_SEED_KMS_KEY_ID) before mainnet.
model MasterSeedStore {
  id         String   @id @default(cuid())
  version    Int      @unique @default(1)
  ciphertext String
  algorithm  String   @default("AES-256-GCM")
  kmsKeyId   String?
  createdAt  DateTime @default(now())
}

enum CryptoOrderType {
  BUY
  SELL
}

enum CryptoOrderStatus {
  PENDING
  EXECUTED
  FAILED
  REFUNDED
}

model CryptoOrder {
  id      String          @id @default(cuid())
  userId  String
  type    CryptoOrderType
  asset   String
  network String

  quotedPrice Decimal @db.Decimal(20, 8)
  quotedTotal Decimal @db.Decimal(20, 8)

  marketPrice Decimal @db.Decimal(20, 8)
  actualCost  Decimal @db.Decimal(20, 8)

  platformFee   Decimal @db.Decimal(20, 8)
  networkFee    Decimal @db.Decimal(20, 8)
  spreadCapture Decimal @db.Decimal(20, 8)

  cryptoAmount   Decimal           @db.Decimal(36, 18)
  status         CryptoOrderStatus @default(PENDING)
  binanceOrderId String?
  idempotencyKey String?           @unique

  createdAt  DateTime  @default(now())
  executedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([asset, network])
  @@index([createdAt])
}

model OnChainTransaction {
  id            String    @id @default(cuid())
  userId        String
  type          String
  asset         String
  network       String
  amount        Decimal   @db.Decimal(36, 18)
  txHash        String?   @unique
  fromAddress   String
  toAddress     String
  status        String
  gasUsed       Decimal?  @db.Decimal(20, 8)
  confirmations Int       @default(0)
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([asset, network])
  @@index([txHash])
}

/// Per-user whitelist of destination withdrawal addresses. A new entry
/// is created in PENDING state (confirmedAt = null) on the first
/// withdrawal attempt; the user is emailed a confirmation token. After
/// confirmation, a 24-hour cooldown elapses before withdrawals to that
/// address are permitted. Limits damage from a compromised account.
model WithdrawalAddressWhitelist {
  id           String    @id @default(uuid())
  userId       String
  key          String // canonicalised `${chain}:${address.toLowerCase()}` for uniqueness
  asset        String
  network      String
  toAddress    String
  label        String?
  confirmToken String?
  confirmedAt  DateTime?
  activeAt     DateTime? // cooldown end — withdrawals before this are rejected
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/// Platform-owned bank accounts users send fiat deposits to. Admin-
/// managed via /api/admin/platform-banks. Mobile reads the active rows
/// to show the correct beneficiary for the user's deposit currency,
/// replacing the previously-hardcoded constant.
model PlatformBankAccount {
  id            String   @id @default(uuid())
  currency      String // ISO 4217 (USD, EUR, GBP, AED, SAR, EGP, LYD, ...)
  country       String // ISO 3166-1 alpha-2
  bankName      String
  accountName   String
  accountNumber String?
  iban          String?
  swift         String?
  sortCode      String?
  routingNumber String?
  branch        String?
  memo          String? // free text shown to the user (reference instructions etc.)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([currency])
  @@index([country])
  @@index([isActive])
}
