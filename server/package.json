{
  "name": "promrkts-server",
  "version": "1.0.0",
  "description": "Crypto exchange backend for promrkts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "seed:rates": "ts-node --transpile-only scripts/seed-rates.ts",
    "seed:admin": "ts-node --transpile-only scripts/create-admin.ts",
    "setup:sim": "npm run seed:rates && npm run seed:admin",
    "simulate": "ts-node --transpile-only scripts/simulate-platform-activity.ts",
    "simulate:verbose": "ts-node --transpile-only scripts/simulate-platform-activity.ts --verbose",
    "simulate:admin": "ts-node --transpile-only scripts/simulate-platform-activity.ts --admin",
    "backfill:fees-usd": "ts-node --transpile-only scripts/backfill-platform-fee-usd.ts",
    "backfill:fees-history": "ts-node --transpile-only scripts/seed-fees-from-history.ts",
    "preflight": "ts-node --transpile-only scripts/preflight.ts",
    "backup:db": "bash scripts/backup-db.sh",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.53.1",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "ecpair": "^3.0.1",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.16.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "qrcode": "^1.5.3",
    "redis": "^5.12.1",
    "socket.io": "^4.7.4",
    "speakeasy": "^2.0.0",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.3.0",
    "twilio": "^6.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^6.4.15",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
