# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/tazdan"
# Production remote databases must use sslmode=require. Keep Prisma pools
# small per app process; raise only after checking the DB plan connection cap.
# DATABASE_URL="postgresql://user:password@host:25060/defaultdb?sslmode=require"
# DB_CONNECTION_LIMIT=3
# DB_POOL_TIMEOUT=20

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 64
# JWT_SECRET and JWT_REFRESH_SECRET MUST be different in production.
# The server refuses to start if these are missing or look like placeholders.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5001
# Comma-separated list of allowed web origins. LAN/localhost is allowed
# automatically when NODE_ENV != "production" for Expo development.
CLIENT_URL="https://tazdan.com"
NODE_ENV="development"
# Production defaults to one worker to protect small Postgres pools. Scale this
# only when DB_CONNECTION_LIMIT * CLUSTER_WORKERS fits your database plan.
# CLUSTER_WORKERS=1

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# Used once on first boot by seedAdmin(). After the first boot, rotate
# this password through the admin UI and remove from the environment.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# ── Error tracking ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Log level ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate limiting (defaults are now safe in code) ───────────────────────────
# Override only if you know what you're doing. The defaults in
# src/middleware/rateLimiters.ts are 300 req/min global, 10/15min for auth.

# ── Email transport ─────────────────────────────────────────────────────────
# PREFERRED: Resend HTTP API (port 443). Cloud hosts (DigitalOcean, etc.) block
# outbound SMTP ports (25/465/587), so SMTP/Gmail times out (ETIMEDOUT) and no
# mail sends. Resend goes over HTTPS, which is never blocked. When set it takes
# precedence over SMTP below. Get a key at https://resend.com and verify the
# tazdan.com sending domain (DNS) so noreply@/hi@/txn@ are authorized senders.
RESEND_API_KEY=""
# Base URL for email images (logos). Defaults to the client origin (CLIENT_URL),
# i.e. logos load from https://<your-site>/logo-black.png. Images MUST be hosted
# on the sending domain (not base64 data URIs) for Gmail inbox placement.
# EMAIL_ASSET_BASE="https://tazdan.com"
#
# DELIVERABILITY (DNS, set once at the registrar — required by Gmail/Yahoo/MS):
#   1. Resend domain verification records (SPF + DKIM) — from the Resend dashboard.
#   2. DMARC TXT record at host `_dmarc`:
#        v=DMARC1; p=none; rua=mailto:dmarc@tazdan.com
#      Start at p=none (monitor), tighten to p=quarantine/p=reject once mail passes.

# ── SMTP (fallback — used only when RESEND_API_KEY is unset, e.g. local dev) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="moeawidan99@gmail.com"
SMTP_PASS="uwwe wwym sxfl jymf"
# Per-purpose From addresses. Defaults (used when unset):
#   auth → noreply@tazdan.com   welcome → hi@tazdan.com   txn → txn@tazdan.com
# NB: with a provider that rewrites the From to the mailbox owner (e.g. plain
# Gmail SMTP), these only stick once SMTP_USER is on tazdan.com or the aliases
# are verified send-as addresses.
MAIL_FROM_AUTH=""
MAIL_FROM_WELCOME=""
MAIL_FROM_TXN=""

# ── Crypto custody ──────────────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption of the BIP-39 master seed (DEV only).
# Generate with: openssl rand -hex 32
MASTER_SEED_ENC_KEY=""
# PRODUCTION CUSTODY (recommended): AWS KMS envelope encryption. Set the KMS
# key ARN/ID and the seed's data-key is wrapped by KMS — the plaintext key
# never touches disk/env, so a DB or env leak alone CANNOT decrypt the seed.
# Free tier: 20k KMS requests/mo. Needs AWS creds in the standard SDK chain.
# MASTER_SEED_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/abcd-..."
# AWS_REGION="us-east-1"
#
# Multi-sig withdrawals: at/above WITHDRAWAL_MULTISIG_USD, N distinct admins
# must approve before funds release (protects against a single leaked admin).
# WITHDRAWAL_MULTISIG_USD=10000
# WITHDRAWAL_MULTISIG_N=2
#
# Ledger backfill on boot (idempotent; syncs ledger ↔ Wallet). Off once stable.
# LEDGER_BACKFILL_ON_BOOT=1
# Optional BIP-39 passphrase. If set, MUST NEVER change — changing it
# silently invalidates all derived user addresses.
MASTER_SEED_PASSPHRASE=""

# ── Phase 2: Binance execution ──────────────────────────────────────────────
# Restrict to spot trading. NEVER enable withdrawals on this API key.
# IP-allowlist your server.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_REST_URL=https://api.binance.com

# ── DEX aggregator: 1inch ───────────────────────────────────────────────────
# ONEINCH_API_KEY=

# ── Treasury integrity (double-entry ledger + fund audit) ───────────────────
# Periodic reconciliation re-derives ledger balances and checks money
# conservation. Fund audit compares internal balances vs net deposits/
# withdrawals/admin-credits to detect missing or conjured funds.
# LEDGER_RECONCILE_MS=300000     # ledger reconciliation interval (5 min)
# FUND_AUDIT_MS=600000           # fund-integrity audit interval (10 min)
# FUND_AUDIT_HALT=1              # PRODUCTION: halt trading on a fund breach.
#                                 # Leave unset in dev/staging (seed balances
#                                 # bypass the deposit flow and would trip it).

# ── FX rates ────────────────────────────────────────────────────────────────
# Standard fiat pairs resolve in this order: admin override → OpenExchangeRates
# (if key set) → Frankfurter (free) → open.er-api (free) → static fallback.
OPENEXCHANGERATES_APP_ID=
# Cache TTL for fetched rates, ms (default 60000 = 1 min).
# FX_CACHE_TTL_MS=60000
# How long an admin price OVERRIDE wins over the live feed, ms (default 2h).
# Was effectively 24h, which let a forgotten override freeze a pair (e.g.
# USD/LYD stuck at an old value) and made the admin "Refresh" button a no-op.
# Shorter = a stale override yields back to live Fulus faster.
# FX_OVERRIDE_MAX_AGE_MS=7200000
# Set to 1 to demote legacy auto-persisted rows wrongly left isActive=true on
# boot (one-shot, idempotent). Safe to leave on; clears frozen auto-rates.
# FX_CLEAR_STALE_OVERRIDES_ON_BOOT=1
#
# LYD PARALLEL (parallel-market) rate — PRIMARY source: Fulus API.
# Real-time feed of USD/EUR/GBP/TRY/EGP/TND/SAR/AED vs LYD (https://fulus.ly).
# When FULUS_API_TOKEN is set it wins over the scraper below for any FIAT/LYD
# pair. A webhook keeps rates current instantly; on a cache-miss the provider
# polls GET /rates/current once (well within the 10k/day quota).
FULUS_API_TOKEN=
# Secret for verifying the X-Webhook-Signature (HMAC-SHA256) on inbound
# rate.created events. Get it from the Fulus dashboard when you add the webhook
# URL (point it at https://<host>/api/exchange/webhook/fulus).
FULUS_WEBHOOK_SECRET=
# FULUS_BASE_URL=https://fulus.ly/api/v1
# FULUS_CACHE_TTL_MS=600000   # how long a webhook-fed rate stays fresh (10 min)
# Days of history to backfill per currency on boot from GET /rates/history, so
# the admin charts are populated immediately (default 7; 0 disables). Only pulls
# for pairs that are still sparse, so it won't re-fetch on every restart.
# FULUS_BACKFILL_DAYS=7
#
# FALLBACK source if Fulus is unset/down: USD/LYD parallel rate scraped from
# blackmarketlive.org (USD/EUR/GBP/AED/SAR/… vs LYD). Override the URL only if
# it moves; the parser expects per-currency `alt="usd"` rows. Falls back to the
# admin override → static value if the scrape also fails.
# LYD_PARALLEL_URL=https://en.blackmarketlive.org/lyd/
#
# Adaptive USD/LYD "soft order book": net buy pressure skews our rate ABOVE the
# scraped market floor; low demand never drops below it.
# LYD_SKEW_MAX_PCT=0.06       # max upward skew over the floor (6%)
# LYD_SKEW_HALFLIFE_S=3600    # net-flow decay half-life (1h)
# LYD_SKEW_REF_USD=50000      # net USD flow mapping to the full max skew

# ── Phase 3: on-chain settlement ────────────────────────────────────────────
# Blockchain RPC providers
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
QUICKNODE_RPC_URL=
# QUICKNODE_SOL_RPC=
# TRON_FULL_NODE=https://api.trongrid.io

# On-chain contract addresses
USDT_ERC20_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Shared secret for the deposit webhook endpoint.
# Required in production. Requests must include X-Webhook-Secret header.
DEPOSIT_WEBHOOK_SECRET=""

# Future: AWS KMS migration for the master seed.
# MASTER_SEED_KMS_KEY_ID=

# ── Banking Metadata System ───────────────────────────────────────────────────
# Primary provider: IBAN.com Bank Suite API (paid, global coverage)
# Get API key from: https://www.iban.com/bank-suite-api
IBAN_COM_API_KEY=
# Enable/disable IBAN.com provider
USE_IBAN_COM=true

# Free fallback provider: OpenIban (limited coverage, free)
# Documentation: https://openiban.com/
USE_OPENIBAN=true

# Local static fallback (always enabled as last resort)
ENABLE_LOCAL_BANK_CACHE=true

# Bank data cache TTL in milliseconds (default: 24 hours)
BANK_CACHE_TTL=86400000

# ── Twilio (WhatsApp, SMS, Phone OTP) ───────────────────────────────────────
# All optional in dev — when absent the service logs/simulates. Required in prod.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WhatsApp-enabled sender (sandbox: whatsapp:+14155238886 / prod: your approved number)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SMS sender number (E.164)
# TWILIO_SMS_FROM=+12025550123
# Twilio Verify Service SID — create at console.twilio.com/verify
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sumsub KYC ───────────────────────────────────────────────────────────────
# Set KYC_PROVIDER=SUMSUB to activate. MOCK works without credentials in dev.
# KYC_PROVIDER=SUMSUB
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_BASE_URL=https://api.sumsub.com

# ── On-ramp provider ─────────────────────────────────────────────────────────
# Options: MOCK (default), STRIPE, CHECKOUT
# ONRAMP_PROVIDER=CHECKOUT

# Checkout.com — https://dashboard.checkout.com
# CHECKOUT_SECRET_KEY=sk_...
# CHECKOUT_PROCESSING_CHANNEL_ID=pc_...
# CHECKOUT_WEBHOOK_SECRET=

# ── Deposit webhooks ─────────────────────────────────────────────────────────
# Alchemy webhook signing key (set in Alchemy dashboard > Webhooks)
# ALCHEMY_WEBHOOK_SIGNING_KEY=
# Trongrid event API key (set in Trongrid dashboard > Events)
# TRON_WEBHOOK_API_KEY=


# ── Mailchimp (waitlist, client-side env — set in client/.env) ───────────────
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# MAILCHIMP_LIST_ID=xxxxxxxxxx
